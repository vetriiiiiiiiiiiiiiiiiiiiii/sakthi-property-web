# Server Port
PORT=5000
NODE_ENV=development
# Exact comma-separated browser origins permitted to send authenticated requests.
CLIENT_ORIGINS=http://localhost:3000

# PostgreSQL Connection String (Prisma ORM)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sakthi_property?schema=public"

# Persistent upload directory on the VPS (keep outside the web root)
FILE_STORAGE_DIR=/var/lib/sakthi-property/uploads

# Session Secret (random 32+ characters string used to sign HMAC tokens)
AUTH_SECRET="your-super-secret-auth-key-change-this-in-production"

# One-Time Setup Key (used for initial admin setup via /api/auth/setup)
AUTH_SETUP_KEY="your-secret-setup-key"

# Cookie Security (automatically true when NODE_ENV=production)
COOKIE_SECURE=false

# Google OAuth 2.0 Client ID (matching frontend VITE_GOOGLE_CLIENT_ID)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# Allow first-time Google users to become administrators. This requires
# GOOGLE_ALLOWED_EMAIL_DOMAINS to be configured.
GOOGLE_AUTO_PROVISION=false
# Optional comma-separated allowlist, for example: sakthiproperty.com
GOOGLE_ALLOWED_EMAIL_DOMAINS=

# Email Service (Resend API key for password reset OTP emails)
RESEND_API_KEY=""
MAIL_FROM="Sakthi Property <onboarding@resend.dev>"
