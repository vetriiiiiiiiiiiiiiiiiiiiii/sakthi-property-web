# Frontend Environment Configuration
# Leave empty when the frontend and API share a domain. Otherwise use the
# public HTTPS API origin, e.g. https://api.example.com.
VITE_API_URL=http://localhost:5000

# Google OAuth 2.0 Client ID (from Google Cloud Console)
# Obtain this by creating an OAuth 2.0 Web Application credential in GCP
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Explicitly opt in only for browser-only demos without the API or PostgreSQL.
# Data is stored in the browser under sakthi_property_data_v1.
VITE_STANDALONE_MODE=false
